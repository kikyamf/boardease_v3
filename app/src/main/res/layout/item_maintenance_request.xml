<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white"
    app:strokeWidth="2dp"
    app:strokeColor="#2196F3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvBoarderName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="John Doe"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In Progress"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/status_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- Boarding House and Room -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvBoardingHouse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sunset Boarding House"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvRoomNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room 101"
                android:textSize="14sp"
                android:textColor="#666666" />

        </LinearLayout>

        <!-- Maintenance Type and Priority -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvMaintenanceType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Plumbing"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF5722" />

            <TextView
                android:id="@+id/tvPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FF5722" />

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Water leak in the bathroom sink"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="12dp"
            android:lineSpacingExtra="2dp" />

        <!-- Date Information Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_rounded_light_gray"
            android:padding="12dp">

            <!-- Date Reported -->
            <TextView
                android:id="@+id/tvDateReported"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date Reported: Nov 3, 2025"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginBottom="6dp" />

            <!-- Date Approved -->
            <TextView
                android:id="@+id/tvDateApproved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date Approved: Nov 4, 2025"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginBottom="6dp" />

            <!-- Approved On / Date Completed -->
            <TextView
                android:id="@+id/tvApprovedOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approved On: Nov 4, 2025"
                android:textSize="13sp"
                android:textColor="#666666" />
        </LinearLayout>

        <!-- Mark as Completed Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarkAsCompleted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mark as Completed"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/white"
            android:paddingVertical="12dp"
            app:cornerRadius="8dp"
            app:strokeWidth="0dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>






























