<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Status Bar -->

    <!-- Fixed Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/white"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GCash Information"
            android:textSize="20sp"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:textColor="#000000" />

        <View
            android:layout_width="36dp"
            android:layout_height="36dp" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8F9FA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- GCash Details Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GCash Details"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#212529"
                    android:layout_marginBottom="12dp" />

                <!-- GCash Number -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GCash Number *"
                    android:textSize="14sp"
                    android:textColor="#495057"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etGcashNumber"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/modern_edittext_focused"
                    android:padding="16dp"
                    android:hint="Enter GCash number"
                    android:textColor="#212529"
                    android:textColorHint="#6C757D"
                    android:inputType="phone"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="16sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- GCash QR Code Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GCash QR Code"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#212529"
                    android:layout_marginBottom="12dp" />

                <!-- QR Code Container with Camera Button Overlay -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/ivGcashQrCode"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/placeholder"
                        android:background="@drawable/rounded_rectangle_bg"
                        android:padding="8dp"
                        android:contentDescription="GCash QR Code" />

                    <!-- Camera Icon Button at Bottom Right -->
                    <ImageButton
                        android:id="@+id/btnSelectQrCode"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:src="@drawable/ic_camera1"
                        android:tint="@color/white"
                        android:background="@drawable/rounded_camera_button"
                        android:scaleType="centerInside"
                        android:padding="10dp"
                        android:contentDescription="Select QR Code"
                        android:elevation="4dp" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your GCash QR code for receiving payments"
                    android:textSize="14sp"
                    android:textColor="#6C757D"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Update Button -->
            <Button
                android:id="@+id/btnSaveChanges"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:layout_marginTop="8dp"
                android:text="Save Changes"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:letterSpacing="0.5"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_semibold"
                app:backgroundTint="#A18167"
                app:cornerRadius="12dp"
                android:elevation="4dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>








