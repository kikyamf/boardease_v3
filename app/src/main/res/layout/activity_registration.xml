<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Fixed Header -->
    <LinearLayout
        android:id="@+id/registrationHeader"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:background="@drawable/registration_header_gradient"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back4"
            app:tint="@android:color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Join BoardEase"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="22sp"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Progress Indicator -->
            <LinearLayout
                android:id="@+id/progressIndicator"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="40dp">

                <TextView
                    android:id="@+id/progressCircle1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="1"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:background="@drawable/progress_circle_filled" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="#DDDDDD" />

                <TextView
                    android:id="@+id/progressCircle2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="2"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:background="@drawable/progress_circle_hollow" />
            </LinearLayout>

            <!-- Google Sign-Up Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleSignUp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="Sign up with Google"
                android:textAllCaps="false"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#444444"
                android:textSize="16sp"
                android:backgroundTint="@android:color/white"
                app:cornerRadius="12dp"
                app:strokeColor="#DDDDDD"
                app:strokeWidth="1dp"
                app:icon="@drawable/google"
                app:iconTint="@null"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconPadding="12dp"
                android:elevation="2dp" />

            <!-- "OR" Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#EEEEEE" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp"
                    android:text="OR CONTINUE WITH EMAIL" android:fontFamily="@font/poppins_medium" android:textColor="#AAAAAA" android:textSize="10sp" android:letterSpacing="0.1" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#EEEEEE" />
            </LinearLayout>

            <!-- Step 1: Basic Information -->
            <LinearLayout
                android:id="@+id/step1Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step 1: Basic Information"
                            android:textSize="18sp"
                            android:textColor="#212529"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginBottom="16dp" />

                        <!-- Join as -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Join as *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <AutoCompleteTextView
                            android:id="@+id/spinnerRole"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Select role"
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:cursorVisible="false"
                            android:drawableEnd="@drawable/ic_dropdown_arrow"
                            android:drawablePadding="8dp"
                            android:layout_marginBottom="16dp" />

                        <!-- First Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="First Name *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/etFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Enter first name"
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:inputType="textCapWords"
                            android:layout_marginBottom="16dp" />

                        <!-- Middle Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Middle Name"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/etMiddleName"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Enter middle name (optional)"
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:inputType="textCapWords"
                            android:layout_marginBottom="16dp" />

                        <!-- Last Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last Name *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/etLastName"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Enter last name"
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:inputType="textCapWords"
                            android:layout_marginBottom="16dp" />

                        <!-- Suffix -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Suffix"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <AutoCompleteTextView
                            android:id="@+id/spinnerSuffix"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Select suffix"
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:cursorVisible="false"
                            android:drawableEnd="@drawable/ic_dropdown_arrow"
                            android:drawablePadding="8dp"
                            android:layout_marginBottom="16dp" />

                        <!-- Birthdate -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Birthdate *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/etBirthDate"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Select birthdate"
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:drawableStart="@drawable/ic_calendar"
                            app:drawableTint="#A18167"
                            android:drawablePadding="8dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Step 2: Contact & Security -->
            <LinearLayout
                android:id="@+id/step2Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step 2: Contact &amp; Security"
                            android:textSize="18sp"
                            android:textColor="#212529"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginBottom="16dp" />

                        <!-- Email Address -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email Address *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Enter email address"
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:inputType="textEmailAddress"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvEmailValidation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="12sp"
                            android:visibility="gone"
                            android:textColor="#D32F2F" />

                        <!-- Phone Number -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone Number *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+63 "
                                android:textColor="#495057"
                                android:fontFamily="@font/poppins_medium"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/etPhone"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="9XXXXXXXXX"
                                android:textColor="#212529"
                                android:textColorHint="#6C757D"
                                android:fontFamily="@font/poppins_regular"
                                android:textSize="16sp"
                                android:inputType="phone"
                                android:maxLength="10" />
                        </LinearLayout>

                        <!-- Password -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Create Password *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="8dp">

                            <EditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/modern_edittext_focused"
                                android:padding="16dp"
                                android:paddingEnd="48dp"
                                android:hint="Enter password"
                                android:textColor="#212529"
                                android:textColorHint="#6C757D"
                                android:fontFamily="@font/poppins_regular"
                                android:textSize="16sp"
                                android:inputType="textPassword" />

                            <ImageView
                                android:id="@+id/ivPasswordToggle"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="16dp"
                                android:src="@drawable/ic_eye_off"
                                android:contentDescription="Toggle password visibility"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackgroundBorderless" />
                        </FrameLayout>

                        <!-- Password Criteria -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:layout_marginBottom="16dp">
                            <TextView android:id="@+id/tvCriteriaLength" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• At least 8 characters" android:fontFamily="@font/poppins_regular" android:textSize="11sp" android:textColor="#D32F2F" />
                            <TextView android:id="@+id/tvCriteriaUpper" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• One Uppercase Letter (A-Z)" android:fontFamily="@font/poppins_regular" android:textSize="11sp" android:textColor="#D32F2F" />
                            <TextView android:id="@+id/tvCriteriaLower" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• One Lowercase Letter (a-z)" android:fontFamily="@font/poppins_regular" android:textSize="11sp" android:textColor="#D32F2F" />
                            <TextView android:id="@+id/tvCriteriaDigit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• One Digit (0-9)" android:fontFamily="@font/poppins_regular" android:textSize="11sp" android:textColor="#D32F2F" />
                            <TextView android:id="@+id/tvCriteriaSpecial" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• One Special character" android:fontFamily="@font/poppins_regular" android:textSize="11sp" android:textColor="#D32F2F" />
                        </LinearLayout>

                        <!-- Terms and Conditions -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <CheckBox
                                android:id="@+id/cbAgree"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:buttonTint="#A18167" />
                            <TextView
                                android:id="@+id/tvAgreeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="I agree to the Terms and Privacy"
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="#444444"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Register Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="NEXT"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:background="@drawable/button_primary_gradient"
                app:backgroundTint="@null"
                app:cornerRadius="12dp"
                android:elevation="4dp"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account?"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#666666" />
                <TextView
                    android:id="@+id/tvLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Login"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="#A18167" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
