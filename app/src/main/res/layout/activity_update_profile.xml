<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Fixed Header -->
    <LinearLayout
        android:id="@+id/registrationHeader"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:background="@drawable/registration_header_gradient"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back4"
            app:tint="@android:color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Complete Your Profile"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="22sp"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Progress Indicator -->
            <LinearLayout
                android:id="@+id/progressIndicator"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="40dp">

                <TextView
                    android:id="@+id/progressCircle1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="1"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:background="@drawable/progress_circle_filled" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="#DDDDDD" />

                <TextView
                    android:id="@+id/progressCircle2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="2"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:background="@drawable/progress_circle_hollow" />

                <View
                    android:id="@+id/progressLine3"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="#DDDDDD"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/progressCircle3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="3"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:background="@drawable/progress_circle_hollow"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Step 1: Permanent Address -->
            <LinearLayout
                android:id="@+id/step1Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Permanent Address"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="18sp"
                            android:textColor="#212529"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Province *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <AutoCompleteTextView
                            android:id="@+id/spinnerProvince"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Select Province"
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:cursorVisible="false"
                            android:drawableEnd="@drawable/ic_dropdown_arrow"
                            android:drawablePadding="8dp"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Municipality/City *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <AutoCompleteTextView
                            android:id="@+id/spinnerMunicipality"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Select Municipality"
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:cursorVisible="false"
                            android:drawableEnd="@drawable/ic_dropdown_arrow"
                            android:drawablePadding="8dp"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Barangay *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <AutoCompleteTextView
                            android:id="@+id/spinnerBarangay"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Select Barangay"
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:cursorVisible="false"
                            android:drawableEnd="@drawable/ic_dropdown_arrow"
                            android:drawablePadding="8dp"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detailed Address *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/etDetailedAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Street Name, Building, House No."
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:inputType="textCapSentences|textMultiLine"
                            android:layout_marginBottom="16dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Step 2: Identity Verification -->
            <LinearLayout
                android:id="@+id/step2Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Identity Verification"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="18sp"
                            android:textColor="#212529"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Valid ID Type *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <AutoCompleteTextView
                            android:id="@+id/spinnerVId"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Select ID Type"
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:cursorVisible="false"
                            android:drawableEnd="@drawable/ic_dropdown_arrow"
                            android:drawablePadding="8dp"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Upload Front ID Photo *"
                            android:fontFamily="@font/poppins_medium"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:layout_marginBottom="8dp"/>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F9F9F9">
                            <ImageView
                                android:id="@+id/ivUploadF"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/upload"
                                android:scaleType="centerInside"
                                android:padding="30dp" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:id="@+id/backIdSection"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Upload Back ID Photo *"
                                android:fontFamily="@font/poppins_medium"
                                android:textSize="14sp"
                                android:textColor="#495057"
                                android:layout_marginBottom="8dp"/>

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                android:layout_marginBottom="16dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#F9F9F9">
                                <ImageView
                                    android:id="@+id/ivUploadB"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/upload"
                                    android:scaleType="centerInside"
                                    android:padding="30dp" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ID Number *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/etIdNumber"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:padding="16dp"
                            android:hint="Enter ID Number"
                            android:textColor="#212529"
                            android:textColorHint="#6C757D"
                            android:fontFamily="@font/poppins_regular"
                            android:textSize="16sp"
                            android:inputType="text"
                            android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-"
                            android:layout_marginBottom="16dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Step 3: Permits and Payment (Owners) -->
            <LinearLayout
                android:id="@+id/step3Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Payment Information"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="18sp"
                            android:textColor="#212529"
                            android:layout_marginBottom="16dp"
                            android:layout_marginTop="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GCash Number *"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/modern_edittext_focused"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+63 "
                                android:textColor="#495057"
                                android:fontFamily="@font/poppins_medium"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/etGcashNum"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="Enter GCash Number"
                                android:textColor="#212529"
                                android:textColorHint="#6C757D"
                                android:fontFamily="@font/poppins_regular"
                                android:textSize="16sp"
                                android:inputType="phone" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload GCash QR Code *"
                            android:fontFamily="@font/poppins_medium"
                            android:textSize="14sp"
                            android:textColor="#495057"
                            android:layout_marginBottom="8dp"/>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F9F9F9">
                            <ImageView
                                android:id="@+id/UploadQr"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/upload"
                                android:scaleType="centerInside"
                                android:padding="40dp" />
                        </androidx.cardview.widget.CardView>


                        <!-- Business Permit Section (Owners Only) -->
                        <LinearLayout
                            android:id="@+id/businessPermitSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Business Permits"
                                android:fontFamily="@font/poppins_semibold"
                                android:textColor="#212529"
                                android:textSize="18sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Required for owners to verify business legitimacy."
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="#666666"
                                android:textSize="12sp"
                                android:layout_marginBottom="12dp" />

                            <LinearLayout
                                android:id="@+id/businessPermitContainer"
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddPermit"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="+ Add Business Permit"
                                android:textAllCaps="false"
                                android:fontFamily="@font/poppins_medium"
                                android:textColor="#A18167"
                                app:strokeColor="#A18167"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="NEXT"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/button_primary_gradient"
                app:backgroundTint="@null"
                app:cornerRadius="12dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:elevation="4dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
