<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Back arrow and Title -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back4"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Additional Personal Information for Verification"
                android:textAlignment="textStart"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Valid ID label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Valid ID"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerVId"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edittext_background"/>

        <!-- Upload ID -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            android:layout_marginTop="12dp">

            <!-- Upload ID Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Upload Front ID photo"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivUploadF"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="@drawable/upload"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:background="@drawable/edittext_background"
                android:contentDescription="Upload Front ID" />
        </LinearLayout>

        <!-- Upload ID -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            android:layout_marginTop="12dp">

            <!-- Upload ID Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Upload Back ID photo"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivUploadB"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="@drawable/upload"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:background="@drawable/edittext_background"
                android:contentDescription="Upload Back ID" />
        </LinearLayout>

        <!-- ID Number -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="ID Number"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etidNumber"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/edittext_background"
                android:hint=""
                android:inputType="number"
                android:padding="10dp"
                android:textColor="@color/black" />

        </LinearLayout>

        <!-- Business Permit Section (Only for BH Owner) -->
        <LinearLayout
            android:id="@+id/businessPermitSection"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <!-- Section Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Business Permits"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="As a Boarding House Owner, you are required to upload your business permit(s) for verification. This helps ensure compliance with local regulations and builds trust with potential boarders. You can upload up to 3 business permits."
                android:textColor="@color/black"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <!-- Container for Business Permit Upload Items -->
            <LinearLayout
                android:id="@+id/businessPermitContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- Button to Add Another Permit -->
            <Button
                android:id="@+id/btnAddPermit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#A18167"
                android:text="Add Another Business Permit"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:visibility="gone" />

        </LinearLayout>

        <!-- CheckBox with clickable terms and privacy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cbAgree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#A18167"
                android:checked="false"
                android:padding="4dp"
                android:text=""
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvAgreeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Agree with terms and privacy"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Register Button -->
        <Button
            android:id="@+id/btnReg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#A18167"
            android:text="REGISTER"
            android:textAllCaps="true"
            android:textColor="@android:color/white"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:layout_width="232dp"
                android:layout_height="48dp"
                android:text="Already have an account?"
                android:textAlignment="textEnd"
                android:textColor="@color/black" />
            <Space
                android:layout_width="8dp"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:text="Login."
                android:textColor="@color/black"
                android:textStyle="bold" />

        </LinearLayout>


    </LinearLayout>
</ScrollView>
