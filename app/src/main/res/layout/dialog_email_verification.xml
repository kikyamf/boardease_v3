<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email Verification"
        android:textSize="20sp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="#212529"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvVerificationMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the verification code sent to your new email address"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_regular"
        android:textColor="#6C757D"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- OTP Input Fields -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:paddingHorizontal="4dp">

        <EditText
            android:id="@+id/etCode1"
            android:layout_width="32dp"
            android:layout_height="40dp"
            android:background="@drawable/modern_edittext_focused"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#212529"
            android:padding="0dp"
            android:layout_marginEnd="2dp" />

        <EditText
            android:id="@+id/etCode2"
            android:layout_width="32dp"
            android:layout_height="40dp"
            android:background="@drawable/modern_edittext_focused"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#212529"
            android:padding="0dp"
            android:layout_marginEnd="2dp" />

        <EditText
            android:id="@+id/etCode3"
            android:layout_width="32dp"
            android:layout_height="40dp"
            android:background="@drawable/modern_edittext_focused"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#212529"
            android:padding="0dp"
            android:layout_marginEnd="2dp" />

        <EditText
            android:id="@+id/etCode4"
            android:layout_width="32dp"
            android:layout_height="40dp"
            android:background="@drawable/modern_edittext_focused"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#212529"
            android:padding="0dp"
            android:layout_marginEnd="2dp" />

        <EditText
            android:id="@+id/etCode5"
            android:layout_width="32dp"
            android:layout_height="40dp"
            android:background="@drawable/modern_edittext_focused"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#212529"
            android:padding="0dp"
            android:layout_marginEnd="2dp" />

        <EditText
            android:id="@+id/etCode6"
            android:layout_width="32dp"
            android:layout_height="40dp"
            android:background="@drawable/modern_edittext_focused"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#212529"
            android:padding="0dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnVerifyEmail"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Verify Email"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:letterSpacing="0.5"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_semibold"
        app:backgroundTint="#A18167"
        app:cornerRadius="12dp"
        android:elevation="4dp"
        android:stateListAnimator="@null"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCancelVerification"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Cancel"
        android:textColor="#A18167"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_medium"
        android:background="@android:color/transparent"
        android:layout_marginBottom="8dp" />

</LinearLayout>

