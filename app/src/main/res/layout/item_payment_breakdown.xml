<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="#F9FAFB"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <!-- Checkbox and Period Label Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/checkboxPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/brown"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvPeriodLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1st month"
                android:textSize="16sp"
                android:textColor="#000000"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/poppins_medium"
                android:background="@drawable/bg_status_pending"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

        <!-- Period Dates -->
        <TextView
            android:id="@+id/tvPeriodDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="January 1, 2024 - January 31, 2024"
            android:textSize="12sp"
            android:textColor="#666666"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginBottom="8dp" />

        <!-- Due Date and Amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDueDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Due: January 1, 2024"
                android:textSize="12sp"
                android:textColor="#FF6B35"
                android:fontFamily="@font/poppins_medium" />

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱3,500.00"
                android:textSize="16sp"
                android:textColor="#2E7D32"
                android:fontFamily="@font/poppins_bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

