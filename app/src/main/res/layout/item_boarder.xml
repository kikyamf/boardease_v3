<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp"
    android:backgroundTint="#FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Profile Picture with Circular Border -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="2dp"
            android:background="@drawable/circle_profile_border">

            <!-- Profile Picture (Circular - clipped inside) -->
            <com.example.mock.CircularImageView
                android:id="@+id/ivProfilePicture"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="centerCrop"
                android:src="@drawable/btn_profile"
                android:contentDescription="Boarder Profile" />
        </FrameLayout>

        <!-- Details Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <!-- Boarder Name -->
            <TextView
                android:id="@+id/tvBoarderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textSize="15sp"
                android:textColor="#000000"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Boarding House & Room -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/location"
                    android:contentDescription="Location"
                    android:tint="#666666" />

                <TextView
                    android:id="@+id/tvBoardingInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sample Boarding House - Room 101"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Rental Period -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_calendar"
                    android:contentDescription="Dates"
                    android:tint="#666666" />

                <TextView
                    android:id="@+id/tvRentalPeriod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jan 1, 2024 - Dec 31, 2024"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Rent Type -->
            <TextView
                android:id="@+id/tvRentType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Private Room"
                android:textSize="13sp"
                android:textColor="#2E7D32"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Status Badge - Right Side -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/poppins_medium"
            android:background="@drawable/bg_status_approved"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_gravity="center_vertical|end" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>































