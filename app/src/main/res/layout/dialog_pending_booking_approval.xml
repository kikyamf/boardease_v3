<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@drawable/dialog_background"
    android:gravity="center">

    <!-- Pending Icon -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="4dp"
        android:backgroundTint="#FFF3E0">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_clock"
            android:contentDescription="Pending Approval"
            android:tint="#FF9800"
            android:padding="16dp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitlePending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pending Approval"
        android:textSize="24sp"
        android:fontFamily="@font/poppins_bold"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Message Content -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#F9FAFB"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- First message with icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_clock"
                    android:tint="#FF9800"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Pending" />

                <TextView
                    android:id="@+id/tvMessagePending"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="This booking request is currently pending approval."
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#666666"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Second message with icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notification1"
                    android:tint="#FF9800"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Notification" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Please note that your reservation will only be confirmed once it has been reviewed and approved by the boarding house administrator."
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#666666"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- OK Button -->
    <!-- Warning Texts (Visible only when Approved) -->
    <TextView
        android:id="@+id/tvPaymentWarnings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note: Payment is Non-refundable. Payment must be made within 24 hours or the booking will be automatically declined."
        android:textSize="12sp"
        android:textColor="#D32F2F"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelApplication"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/poppins_medium"
            android:backgroundTint="#D32F2F"
            app:cornerRadius="25dp"
            android:paddingVertical="14dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOkPending"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OK"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/poppins_medium"
            android:backgroundTint="#FF9800"
            app:cornerRadius="25dp"
            android:paddingVertical="14dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>

