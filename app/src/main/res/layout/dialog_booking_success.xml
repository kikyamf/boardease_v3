<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- Success Icon -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_check"
        android:contentDescription="Success"
        android:tint="@color/green" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Booking Successful"
        android:textSize="20sp"
        android:fontFamily="@font/poppins_bold"
        android:textColor="@color/brown"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Message Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- First line with icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                android:tint="@color/brown"
                android:layout_marginEnd="8dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Received" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your booking is received by the BH Owner and is subject for approval."
                android:textSize="14sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/dark_gray"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Second line with icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_notification"
                android:tint="@color/brown"
                android:layout_marginEnd="8dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Notification" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="You will receive a notification once the booking is successful."
                android:textSize="14sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/dark_gray"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Third line with icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_history"
                android:tint="@color/brown"
                android:layout_marginEnd="8dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Track" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Track your booking in the Booking Page. Thank you!"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/dark_gray"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

