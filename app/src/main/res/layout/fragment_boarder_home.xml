<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- Verification Status Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVerificationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Status Accent Bar -->
                    <View
                        android:id="@+id/viewStatusAccent"
                        android:layout_width="6dp"
                        android:layout_height="match_parent"
                        android:background="#F57C00" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivStatusIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_info"
                            app:tint="#F57C00" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatusTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Verification Pending"
                                android:textColor="#212121"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvStatusMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Admin is currently reviewing your documents."
                                android:textColor="#616161"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        <!-- Header Section: Location + Icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <!-- Location Header (Replaces Welcome/Name as per design) -->
            <LinearLayout
                android:id="@+id/layoutLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <!-- Line 1: Location Label + Chevron -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textSize="14sp"
                        android:textColor="#999999"
                        android:fontFamily="@font/poppins_regular" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="#999999" />
                </LinearLayout>

                <!-- Line 2: Pin Icon + Current Address -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginTop="2dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/brown" />

                    <TextView
                        android:id="@+id/tvCurrentSearchLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Set your location..."
                        android:textSize="18sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notification & Message Icons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="0dp">

                <!-- Notification with badge -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:id="@+id/ivNotification"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_notification1"
                        android:background="@drawable/icon_hover_effect"
                        android:padding="10dp"
                        android:contentDescription="Notification"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Red Dot -->
                    <View
                        android:id="@+id/badgeNotif"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/red_dot"
                        android:visibility="gone" />

                    <!-- Count Badge -->
                    <TextView
                        android:id="@+id/badgeNotifCount"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/badge_background"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Message with badge -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <ImageView
                        android:id="@+id/ivMessage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_message1"
                        android:background="@drawable/icon_hover_effect"
                        android:padding="10dp"
                        android:contentDescription="Message"
                        android:clickable="true"
                        android:focusable="true" />

                    <View
                        android:id="@+id/badgeMsg"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/red_dot"
                        android:visibility="gone" />

                    <!-- Count Badge -->
                    <TextView
                        android:id="@+id/badgeCount"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/badge_background"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Search Bar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#FFFFFF"
            app:cardCornerRadius="30dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/search"
                    android:contentDescription="Search" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Look for BH by name or location..."
                    android:background="@android:color/transparent"
                    android:paddingStart="12dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center_vertical"
                    android:textColor="#000000"
                    android:textColorHint="#999999"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_regular"
                    android:singleLine="true"
                    android:maxLines="1" />

                <ImageView
                    android:id="@+id/ivClearSearch"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Clear Search"
                    android:tint="#666666"
                    android:layout_marginStart="12dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recommended Boarding Houses Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp"
            android:clipChildren="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recommended Boarding Houses"
                android:textSize="17sp"
                android:textColor="#333333"
                android:fontFamily="@font/poppins_medium" />

            <!-- Progress Bar for Recommended -->
            <ProgressBar
                android:id="@+id/progressBarRecommended"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:visibility="visible"
                android:indeterminateTint="@color/brown" />

            <!-- Horizontal RecyclerView for Recommended BHs -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecommendedBH"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingStart="0dp"
                android:paddingEnd="16dp"
                android:overScrollMode="never"
                android:visibility="gone" />

            <!-- Empty State for Recommended (Search Results) -->
            <TextView
                android:id="@+id/tvRecommendedEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No boarding houses found"
                android:textSize="14sp"
                android:textColor="#999999"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Nearby Boarding Houses Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp">

            <!-- Section Header with See All Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nearby Boarding Houses"
                    android:textSize="17sp"
                    android:textColor="#333333"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewMap"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Map"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/poppins_medium"
                    android:backgroundTint="@color/brown"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_map"
                    app:iconTint="#FFFFFF"
                    app:iconSize="16dp"
                    app:iconPadding="4dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="See All"
                    android:textSize="12sp"
                    android:textColor="@color/brown"
                    android:fontFamily="@font/poppins_medium"
                    android:backgroundTint="@android:color/transparent"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/brown"
                    app:strokeWidth="1dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp" />

            </LinearLayout>

            <!-- Progress Bar for Nearby -->
            <ProgressBar
                android:id="@+id/progressBarNearby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:visibility="visible"
                android:indeterminateTint="@color/brown" />

            <!-- Vertical RecyclerView for Nearby BHs -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNearbyBH"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                android:visibility="gone" />

            <!-- Empty State for Nearby (Search Results) -->
            <TextView
                android:id="@+id/tvNearbyEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No boarding houses found"
                android:textSize="14sp"
                android:textColor="#999999"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
    </ScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>