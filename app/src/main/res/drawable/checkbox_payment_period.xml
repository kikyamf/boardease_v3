<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked state - brown border, white/transparent background, brown checkmark visible -->
    <item android:state_checked="true">
        <layer-list>
            <!-- White background with brown border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/brown" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
            <!-- Brown checkmark -->
            <item
                android:drawable="@drawable/checkbox_checkmark_brown"
                android:gravity="center"
                android:width="14dp"
                android:height="14dp" />
        </layer-list>
    </item>
    <!-- Unchecked state - grey border, white background, no checkmark -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#CCCCCC" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>

